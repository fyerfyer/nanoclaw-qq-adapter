# NanoClaw OneBot Napcat adapter settings
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=nanoclaw-test-token
NAPCAT_SELF_ID=3384461856

# Optional access control (parsed as comma-separated lists)
NAPCAT_ALLOWED_USERS=
NAPCAT_ALLOWED_GROUPS=
NAPCAT_BLOCKED_USERS=
NAPCAT_BLOCKED_GROUPS=
NAPCAT_ADMINS=

# Behavior
NAPCAT_REQUIRE_AT_IN_GROUP=true
NAPCAT_MAX_TEXT_LENGTH=4500

# Group notifications
NAPCAT_WELCOME_MSG=
NAPCAT_GOODBYE_MSG=

# NapCat Docker Compose settings (single-account development stack)
NAPCAT_WS_PORT=3001
NAPCAT_WEBUI_PORT=6099
NAPCAT_UID=1000
NAPCAT_GID=1000

# ============================================================
# Multi-account test stack (docker-compose.test.yml)
# ============================================================
# Bot account: the QQ your Nanoclaw Adapter logs in as.
NAPCAT_BOT_ACCOUNT=3384461856
NAPCAT_BOT_WS_PORT=3001
NAPCAT_BOT_HTTP_PORT=3100
NAPCAT_BOT_WEBUI_PORT=6099

# Test user A: a second bot account for multi-user group chat tests.
NAPCAT_USER_A_ACCOUNT=2157875424
NAPCAT_USER_A_HTTP_PORT=3000
NAPCAT_USER_A_WS_PORT=3002
NAPCAT_USER_A_WEBUI_PORT=6100

# Test user B: a second account for multi-user group chat tests.
NAPCAT_USER_B_ACCOUNT=2101197401
NAPCAT_USER_B_HTTP_PORT=3003
NAPCAT_USER_B_WS_PORT=3004
NAPCAT_USER_B_WEBUI_PORT=6101
